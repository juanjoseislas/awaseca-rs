# Copy this file to `.dev.vars` (gitignored) and fill in real values for
# local development. In production these are set in the Cloudflare Pages
# dashboard under Settings -> Environment variables, not in this file.
#
# Project Settings -> API Keys in your Supabase project gives you both
# values. Use the "Secret" API key here (the current name for what used
# to be called `service_role` — same purpose: full access, bypasses RLS,
# server-side only). NEVER the "Publishable"/`anon` key — this table has
# no public access (see supabase/schema.sql).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-api-key

# Sends the auto-generated sales-brief email after each diagnostic
# submission (see "Sales-brief notifications" in README.md). Get the API
# key from resend.com -> API Keys. RESEND_FROM_EMAIL must be an address on
# a domain verified in your Resend account; SALES_NOTIFICATION_EMAIL is
# whoever on the sales team should receive the brief. If either var is
# missing, the submission still saves normally — only the email is skipped.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Awaseca <diagnosticos@awaseca.com>
SALES_NOTIFICATION_EMAIL=ventas@awaseca.com
